# Shell-compatible: cp .env.example gcp.env, edit, then: set -a; source gcp.env; set +a
GCP_PROJECT=your-project-id
GCP_REGION=europe-west2
GCP_BUCKET=your-project-id-matchmind
RELEASE=v2-demo-001
# Choose a currently available Gemini model in your project's Vertex AI Model Garden.
GEMINI_MODEL=replace-with-enabled-model-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
AGENT_ENABLED=true
